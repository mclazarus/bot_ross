# Bot Ross configuration. Copy to .env and fill in your secrets.
#
# IMPORTANT: never put a comment on the same line as a value. `run.sh` passes this
# file to `docker run --env-file`, which splits each line on the first "=" and takes
# the ENTIRE remainder as the value -- `#` and everything after it included. A line
# written as
#
#     BOT_TIMEZONE=America/New_York  # my timezone
#
# sets BOT_TIMEZONE to the literal string "America/New_York  # my timezone", which is
# not a valid timezone, so the bot falls back to UTC. Every setting below is parsed
# leniently (a bad value falls back to its default rather than crashing the bot), so
# this fails SILENTLY. Keep comments on their own lines, as they are here.

# --- Required ---------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- Optional ---------------------------------------------------------------------

# Max image generations per calendar month. Default: 100.
# NOTE: if you set DAILY_IMAGE_CHANNEL_ID below to enable the daily-image scheduler,
# its shipped schedule fires 4 slots/day (1 generate + 3 edits) -- 4 x ~30 days/month
# =~ 120 generations/month minimum (more on a base-image recovery or a retry) -- which
# alone exceeds this default of 100. Raise API_LIMIT accordingly, or every other
# command gets refused for the rest of the month once the cap is hit.
API_LIMIT=100

# Image model for &paint and &meme. Default: gpt-image-2.6-flare-low.
# Also: gpt-image-2.6-flare, gpt-image-2.6-flare-xhigh, gpt-image-2.6-flare-max,
# gpt-image-2.6-flare-medium, the gpt-image-2.5-flare family (same suffixes),
# gpt-image-2, gpt-image-2-medium, gpt-image-2-low, dall-e-3
IMAGE_MODEL=gpt-image-2.6-flare-low

# Content moderation level. Default: low. Also: auto (gpt-image-2 family only).
IMAGE_MODERATION=low

# GPT model used to generate meme prompts (and, unless SECRET_MAGIC_MODEL is set, the
# nightly secret mixin). Default: gpt-6-sol.
MEME_MODEL=gpt-6-sol

# Starting chance (0.0-1.0) that &paint/&remix silently appends a background gag.
# Default: 0.05. Live rate is then controlled in-process via &magic_rate.
MAGIC_PAINT_RATE=0.05

# Starting chance (0.0-1.0) that the morning daily image is posted as an animated GIF
# instead of a still. Default: 0.20. Live rate is then controlled via &daily_gif_rate.
DAILY_GIF_RATE=0.20

# Chat model that writes the nightly secret magic mixin. Default: unset, which uses MEME_MODEL.
SECRET_MAGIC_MODEL=

# Text model OpenAI uses to write --svg output (the image model draws a reference first).
# Default: gpt-6-sol (best of six compared on 2026-11-07, ~41s, ~$0.05 of text per SVG).
# gpt-6-luna is close behind at ~$0.003.
SVG_MODEL=gpt-6-sol

# Seconds to let in-flight image generations (including a whole | pipe chain) finish
# on shutdown before the bot closes. Default: 300.
# run.sh's STOP_TIMEOUT (default 330) must stay above this.
DRAIN_TIMEOUT=300

# IANA timezone the daily-image schedule's slot times are wall-clock in (the container
# itself runs UTC). Default: America/New_York.
# An unknown name falls back to UTC with a logged warning.
BOT_TIMEZONE=America/New_York

# Discord channel id the daily image and its scheduled edits post to. Default: unset,
# which disables the scheduler entirely. A pasted <#123456789> mention also works.
# See the API_LIMIT note above before enabling this.
DAILY_IMAGE_CHANNEL_ID=

# Discord channel id for the startup greeting ("A wild Bot Ross appears!" with the build
# number). Default: unset, which skips the greeting. A pasted <#123456789> mention also works.
DISCORD_CHANNEL_ID=

# Set false to disable the daily-image scheduler outright, independent of whether a
# channel id is configured. Default: true.
DAILY_IMAGE_ENABLED=true
