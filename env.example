# Required
OPENAI_API_KEY=your_openai_api_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional
# NOTE: if you set DAILY_IMAGE_CHANNEL_ID below to enable the daily-image
# scheduler, its shipped schedule fires 4 slots/day (1 generate + 3 edits) --
# 4 x ~30 days/month =~ 120 generations/month minimum (more on a base-image
# recovery or a retry) -- which alone exceeds this default of 100. Raise
# API_LIMIT accordingly, or every other command gets refused for the rest of
# the month once the cap is hit.
API_LIMIT=100
IMAGE_MODEL=gpt-image-2-low  # default: gpt-image-2-low | also: gpt-image-2, gpt-image-2-medium, gpt-image-2-high, dall-e-3
IMAGE_MODERATION=low         # default: low | also: auto (gpt-image-2 only)
MEME_MODEL=gpt-5.4-mini      # default: gpt-5.4-mini
MAGIC_PAINT_RATE=0.05        # default: 0.05 | chance (0.0-1.0) &paint/&remix silently appends a background gag
DRAIN_TIMEOUT=300            # default: 300 | seconds to let in-flight generations (incl. whole pipe chains) finish on shutdown before closing
BOT_TIMEZONE=America/New_York  # default: America/New_York | IANA zone the daily-image schedule's times are wall-clock in
DAILY_IMAGE_CHANNEL_ID=      # default: unset | channel id the daily image/edits post to; unset disables the scheduler. See the API_LIMIT note above -- 4 slots/day =~ 120/month, so raise API_LIMIT once you set this.
DAILY_IMAGE_ENABLED=true     # default: true | set false to disable the daily-image scheduler outright
